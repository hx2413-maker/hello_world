SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only: generation completion/failure and private assistant/demo quota RPCs.
# Normal member reads, uploads, reservations, tones, and votes use session RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-google-ai-studio-key
# Optional; choose a generateContent-compatible text model available to your key.
GEMINI_MODEL=gemini-3.5-flash-lite
# Server-only: generate a random value of at least 32 characters; keep it stable.
CAMPUS_GUEST_SECRET=replace-with-a-random-guest-secret-at-least-32-characters
# Server-only: random secret used by Vercel to authenticate scheduled refreshes.
CRON_SECRET=replace-with-a-random-cron-secret
# Optional trusted custom domain; Vercel deployment URLs are detected automatically.
SITE_URL=http://localhost:3000
# Public URL of the connected superadmin prompt-chain workspace.
NEXT_PUBLIC_PROMPT_CHAINS_URL=https://campus-prompt-chains.vercel.app
